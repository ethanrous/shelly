{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "lucy",
  "defaultModel": "swift-1.5-27b",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "keepRecentTokens": 10000
  },
  "defaultTools": [
    "+tool_search"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-hermes-memory",
    "git:github.com/ethanrous/pi-subagents@master",
    "npm:pi-mono-ask-user-question",
    "npm:pi-blackhole",
    "npm:pi-token-speed",
    "npm:pi-thinking-tail",
    "npm:pi-bg-tasks",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@datadog/pi-plugin",
    "npm:pi-browser-use"
  ],
  "skills": [
    "!skills/synced/*/built-in-browser",
    "!skills/synced/*/chrome-browser",
    "!skills/synced/*/computer-use",
    "!skills/synced/*/docs",
    "!skills/synced/*/google-workspace",
    "!skills/synced/*/import-memory",
    "!skills/synced/*/morning"
  ],
  "reserveTokens": 24576,
  "timeoutMs": 36000000,
  "workflowTimeoutMs": 36000000,
  "globalTimeoutMs": 36000000,
  "httpIdleTimeoutMs": 0,
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "editorPaddingX": 1,
  "tokenSpeed": {
    "countStrategy": "estimate",
    "useProviderTokens": true,
    "slidingWindow": 2000
  }
}